load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "utils_math",
    hdrs = ["utils/math.hpp"],
)

cc_library(
    name = "utils_bigint",
    hdrs = ["utils/bigint.hpp"],
)

cc_library(
    name = "algebra_concepts",
    hdrs = ["algebra/concepts.hpp"],
)

cc_library(
    name = "algebra_ring_core",
    hdrs = [
        "algebra/ring_array.hpp",
        "algebra/ring_element.hpp",
    ],
    deps = [
        ":algebra_concepts",
        "@xtensor",
        "@xtl",
    ],
)

cc_library(
    name = "algebra_snf",
    hdrs = ["algebra/snf.hpp"],
)

cc_library(
    name = "simd",
    hdrs = glob(["simd/*.hpp"]),
)

cc_library(
    name = "databases",
    hdrs = glob(["databases/*.hpp"]),
    data = glob(
        ["databases/*.db"],
        allow_empty = True,
    ),
    deps = [
        ":utils_math",
        "@rules_cc//cc/runfiles",
    ],
)

cc_library(
    name = "field_core",
    hdrs = [
        "field/gf_base.hpp",
        "field/gf_concepts.hpp",
        "field/gf_element.hpp",
    ],
    deps = [
        ":utils_math",
    ],
)

cc_library(
    name = "gf_array",
    hdrs = ["field/gf_array.hpp"],
    deps = [
        ":field_core",
        "@xtensor",
        "@xtl",
    ],
)

cc_library(
    name = "utils_field",
    hdrs = ["utils/field.hpp"],
    deps = [
        ":field_core",
    ],
)

cc_library(
    name = "poly",
    hdrs = glob(["poly/*.hpp"]),
    deps = [
        ":algebra_concepts",
        ":field_core",
        ":simd",
        ":utils_math",
    ],
)

cc_library(
    name = "utils_poly",
    hdrs = ["utils/poly.hpp"],
    deps = [
        ":poly",
    ],
)

cc_library(
    name = "utils",
    deps = [
        ":utils_bigint",
        ":utils_field",
        ":utils_math",
        ":utils_poly",
    ],
)

cc_library(
    name = "algebra_groups",
    hdrs = [
        "algebra/group_algorithms.hpp",
        "algebra/group_base.hpp",
        "algebra/groups.hpp",
        "algebra/permutation.hpp",
        "algebra/schreier_sims.hpp",
    ],
    deps = [
        ":algebra_concepts",
        ":algebra_snf",
        ":utils_bigint",
    ],
)

cc_library(
    name = "ring",
    hdrs = glob(["ring/*.hpp"]),
    deps = [
        ":algebra_concepts",
        ":algebra_ring_core",
        ":field_core",
        ":utils_bigint",
    ],
)

cc_library(
    name = "field",
    hdrs = glob(
        ["field/*.hpp"],
        exclude = [
            "field/gf_array.hpp",
            "field/gf_base.hpp",
            "field/gf_concepts.hpp",
            "field/gf_element.hpp",
        ],
    ),
    deps = [
        ":algebra_concepts",
        ":databases",
        ":field_core",
        ":gf_array",
        ":poly",
        ":utils_bigint",
        ":utils_field",
        ":utils_math",
        ":utils_poly",
    ],
)

cc_library(
    name = "linalg",
    hdrs = glob(["linalg/*.hpp"]),
    deps = [
        ":algebra_concepts",
        ":algebra_snf",
        ":field_core",
        ":gf_array",
        ":poly",
        ":simd",
        ":utils_bigint",
        "@xtensor",
        "@xtl",
    ],
)

cc_library(
    name = "algebra_matrix_group",
    hdrs = ["algebra/matrix_group.hpp"],
    deps = [
        ":algebra_concepts",
        ":algebra_groups",
        ":field_core",
        ":gf_array",
        ":linalg",
        ":utils_bigint",
    ],
)

cc_library(
    name = "ec",
    hdrs = glob(["ec/*.hpp"]),
    deps = [
        ":algebra_concepts",
        ":field",
        ":field_core",
        ":gf_array",
        ":linalg",
        ":utils_bigint",
        ":utils_math",
    ],
)

cc_library(
    name = "channel",
    hdrs = glob(["channel/*.hpp"]),
    deps = [
        ":field_core",
        ":gf_array",
        ":simd",
        "@xtensor",
        "@xtl",
    ],
)

cc_library(
    name = "coding",
    hdrs = glob(["coding/**/*.hpp"]),
    deps = [
        ":field",
        ":field_core",
        ":gf_array",
        ":linalg",
        ":poly",
        ":ring",
        ":utils_bigint",
        ":utils_math",
        ":utils_poly",
        "@xtensor",
        "@xtl",
    ],
)

cc_library(
    name = "xgalois",
    deps = [
        ":algebra_concepts",
        ":algebra_groups",
        ":algebra_matrix_group",
        ":algebra_ring_core",
        ":algebra_snf",
        ":channel",
        ":coding",
        ":databases",
        ":ec",
        ":field",
        ":field_core",
        ":linalg",
        ":poly",
        ":ring",
        ":simd",
        ":utils",
        "@xtensor",
        "@xtl",
    ],
)
