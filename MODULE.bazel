"""
XGalois Bazel module configuration.
Pure Bzlmod configuration compatible with Bazel 8 and 9.
"""

module(
    name = "xgalois",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "google_benchmark", version = "1.9.5")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_XTL_BUILD_CONTENT = """\
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "xtl",
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
"""

_XTENSOR_BUILD_CONTENT = """\
load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "xtensor",
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.h",
        ],
        allow_empty = True,
    ),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@xtl"],
)
"""

http_archive(
    name = "xtl",
    build_file_content = _XTL_BUILD_CONTENT,
    sha256 = "ee38153b7dd0ec84cee3361f5488a4e7e6ddd26392612ac8821cbc76e740273a",
    strip_prefix = "xtl-0.8.0",
    urls = ["https://github.com/xtensor-stack/xtl/archive/refs/tags/0.8.0.tar.gz"],
)

http_archive(
    name = "xtensor",
    build_file_content = _XTENSOR_BUILD_CONTENT,
    sha256 = "f5f42267d850f781d71097b50567a480a82cd6875a5ec3e6238555e0ef987dc6",
    strip_prefix = "xtensor-0.26.0",
    urls = ["https://github.com/xtensor-stack/xtensor/archive/refs/tags/0.26.0.tar.gz"],
)
